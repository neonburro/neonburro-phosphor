# .env.example
# Copy to .env for local work. Never commit .env. Names only in chat, never values.

# Browser side. The studio's Supabase project, the same one Pulse and the forms use.
VITE_SUPABASE_URL=https://sspbripimqvfdkfbpubq.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server side, Netlify functions only. The key ladder in netlify/functions/_shared.js
# tries these in order. One server key is enough.
SUPABASE_URL=https://sspbripimqvfdkfbpubq.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# A keyed Solana RPC. The public node throttles getTokenAccountsByOwner, which is
# the one call the door depends on. Helius free tier is enough.
SOLANA_RPC_URL=
